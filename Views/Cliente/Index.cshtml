@model IEnumerable<Practica_1.Models.ClienteViewModel>

@{
    ViewData["Title"] = "Listado de clientes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Listado de clientes</h1>
    <a asp-action="Crear" class="btn btn-primary">+ Registrar cliente</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Nombre</th>
                    <th>Apellidos</th>
                    <th>Email</th>
                    <th>Teléfonos</th>
                    <th class="text-end pe-3">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-3">@item.Nombre</td>
                        <td>@item.Apellidos</td>
                        <td>@item.Email</td>
                        <td>
                            @foreach (var tel in item.Telefonos)
                            {
                                <span class="badge bg-secondary me-1">@tel</span>
                            }
                        </td>
                        <td class="text-end pe-3">
                            <a asp-action="Detalle" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                            <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Eliminar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any())
{
    <p class="text-muted text-center mt-4">No hay clientes registrados todavía.</p>
}